# 情绪星球 · 环境变量模板
# 复制为 .env 后按需修改；已存在的系统环境变量优先于本文件。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库。

# ---- Web 服务 ----
# 会话签名密钥。留空时程序会生成随机密钥并写入项目根的 .secret_key 文件。
# 生产部署请显式设置一个 32 字节以上的随机值，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
EMOTION_SECRET_KEY=

# 监听地址与端口。只在本机演示保持 127.0.0.1；部署到服务器改为 0.0.0.0。
HOST=127.0.0.1
PORT=5001

# ---- Agent 工作流 ----
# 1 = 开启「先取数再生成」的 Agent 流程；0 = 退回单轮分析（用于 A/B 对比）。
AGENT_MODE=1

# ---- 本地语音识别（SenseVoice-Small）----
# local = 使用本地离线识别；off = 关闭，前端退回浏览器在线识别。
ASR_MODE=local
# 缺 funasr / torch / torchaudio 时是否自动后台 pip 安装。内网或离线机器建议设 0。
ASR_AUTO_INSTALL=1
# 推理设备：cpu 或 cuda:0。
ASR_DEVICE=cpu
# 单次录音上传上限（字节），默认 20MB。
ASR_MAX_BYTES=20971520
# 启动时是否后台预热语音模型（需要本地已有权重）。0 = 不预热。
ASR_PRELOAD=1

# ---- 大模型：默认模型（部署方配置，用户零门槛）----
# 在这里配一次，所有没填自己 API 的账号共用，用户不需要自己申请密钥。
# API Key 留空则不启用默认模型，未配置的账号使用本地规则模型。
EMOTION_LLM_PROVIDER=openai
EMOTION_LLM_BASE_URL=https://api.deepseek.com/v1
EMOTION_LLM_MODEL=deepseek-chat
EMOTION_LLM_API_KEY=
EMOTION_LLM_TIMEOUT=60
# 每个账号每天可使用的默认模型轮数（对话与 AI 阶段回顾共用），每日 0 点恢复。
# 账号自己的 API 与本地规则不限额；允许范围 1～1000。
EMOTION_LLM_DAILY_LIMIT=10

# ---- 大模型：账号自带 API（可选，进阶）----
# 登录后在网页「AI 设置」中按账号填写 API 地址 / 模型名 / API Key，
# 保存在本地 SQLite 的 user_ai_settings 表中，优先级高于上面的默认模型。
# 清除账号配置后自动回到默认模型。
